# Variables de Entorno Tiandy Tech

# Puerto HTTP (Dev: 8090, Prod Docker NAS: 1030)
PORT=8090

# Entorno: development | production
NODE_ENV=development

# -------------------------------------------------------------
# CLOUDFLARE PAGES — Publicación Automática desde el Panel
# -------------------------------------------------------------
# 1. Nombre del proyecto en Cloudflare Pages
CLOUDFLARE_PROJECT_NAME="tiandy-tech"

# 2. Token de API de Cloudflare con permisos: Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN="tu_token_api_de_cloudflare"

# 3. ID de Cuenta de Cloudflare (opcional / autodetectado con el token)
CLOUDFLARE_ACCOUNT_ID=""

# 4. Alternativa: URL de Deploy Hook (Webhook) si usas integración Git en Pages
# CLOUDFLARE_DEPLOY_HOOK="https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxx-xxxx"
