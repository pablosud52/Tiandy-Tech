{
  "name": "tiandy-tech",
  "version": "1.0.0",
  "description": "Plataforma web técnica unificada Tiandy Tech: Catálogo, Comparador y Backoffice NAS",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:public": "vite build --mode public",
    "start": "node dist/server/index.js",
    "seed": "tsx src/server/db/seed.ts"
  },
  "keywords": [
    "tiandy",
    "cctv",
    "catalog",
    "hardware"
  ],
  "author": "Pablo",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
